{
  "manifest_version": 3,
  "name": "Google Docs English → Spanish",
  "version": "1.1.4",
  "description": "Translate an open Google Doc from English to Spanish locally in Chrome, create a formatted Spanish copy, and add a configurable translated warning to the copy.",
  "minimum_chrome_version": "138",
  "key": "",
  "permissions": [
    "sidePanel",
    "scripting",
    "clipboardWrite",
    "identity"
  ],
  "host_permissions": [
    "https://docs.google.com/*",
    "https://*.googleusercontent.com/*",
    "https://www.googleapis.com/*",
    "https://docs.googleapis.com/*"
  ],
  "oauth2": {
    "client_id": "1019462553183-urekqshigj6dquk83ikl3d6ro0292r0k.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/drive"
    ]
  },
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_title": "Translate Google Doc to Spanish"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  }
}
